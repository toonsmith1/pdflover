# Copy to .env for local development. Never commit .env.
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# OCR is remote by design; keep this key on the backend only.
TYPHOON_OCR_API_KEY=
TYPHOON_OCR_BASE_URL=

# Single-admin advertising control. Generate one with: openssl rand -hex 32
ADS_ADMIN_TOKEN=

# Local temporary-file policy
MAX_UPLOAD_MB=50
TEMP_FILE_TTL_MINUTES=60
